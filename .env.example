# Database connection string (PostgreSQL)
# For Vercel Postgres / Neon / Supabase / Railway:
# Example: postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/[YOUR-DB-NAME]?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/dentalcart?sslmode=require"

# Direct URL for Prisma migrations if using a connection pooler like PgBouncer (optional)
# DIRECT_URL="postgresql://user:password@host:5432/dentalcart"

# JWT Secret for authenticating customer and admin sessions
# Generate a secure 32+ character random string
JWT_SECRET="your-32-character-random-secret-key-for-jwt-session-tokens"

# Application URL (optional)
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
